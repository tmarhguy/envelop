<Window x:Class="Envelop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Envelop" Height="700" Width="960" MinHeight="520" MinWidth="650" Background="#FAF9F6">
 <DockPanel Margin="24">
  <TextBlock DockPanel.Dock="Top" Text="Envelop" FontSize="32" FontWeight="Bold" Margin="0,0,0,20"/>
  <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="#AF2525" TextWrapping="Wrap" Margin="0,12,0,0"/>
  <Grid>
   <StackPanel x:Name="Setup" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="Connect to your Envelop network" FontSize="22"/>
    <TextBlock Text="Supabase project URL"/><TextBox x:Name="ProjectUrl" AutomationProperties.Name="Supabase project URL"/>
    <TextBlock Text="Public project key"/><TextBox x:Name="ProjectKey" AutomationProperties.Name="Public project key"/>
    <Button Content="Connect" Click="Configure"/>
   </StackPanel>
   <StackPanel x:Name="Onboarding" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="Welcome to Envelop" FontSize="24"/>
    <TextBlock Text="Your name"/><TextBox x:Name="DisplayName" MaxLength="32" AutomationProperties.Name="Your name"/>
    <Button x:Name="EnterButton" Content="Enter Envelop" Click="Enter"/>
   </StackPanel>
   <Grid x:Name="Messenger" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBox x:Name="Search" AutomationProperties.Name="Find people"/><Button Content="Find people" Click="FindPeople"/><TextBlock x:Name="Presence" Text="Tomato · checking connection" Margin="0,12"/></StackPanel>
     <ListBox x:Name="People" SelectionChanged="OpenChat" BorderThickness="0" Background="Transparent">
      <ListBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Name}"/><Run Text="{Binding Check}" Foreground="#1D9BF0"/></TextBlock></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
    <DockPanel Grid.Column="2">
     <TextBlock x:Name="ChatTitle" DockPanel.Dock="Top" Text="Choose a conversation" FontSize="24" Margin="0,0,0,18"/>
     <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="QueueHint" TextWrapping="Wrap"/><DockPanel><Button x:Name="SendButton" Content="Send" Click="Send" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Bottom"/><TextBox x:Name="Draft" AcceptsReturn="True" MinHeight="48" MaxHeight="120" TextWrapping="Wrap" AutomationProperties.Name="Message" PreviewKeyDown="DraftKeyDown"/></DockPanel></StackPanel>
     <ListBox x:Name="Messages" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><TextBlock Text="{Binding Sender}" FontSize="12" Foreground="#666666"/><TextBlock Text="{Binding Body}" FontSize="16" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
